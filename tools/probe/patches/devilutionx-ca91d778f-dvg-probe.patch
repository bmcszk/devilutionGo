@@ -1815,6 +1815,52 @@
 
 } // namespace
 
+// StartGame(bool,bool) body up to (but excluding) RunGameLoop: net init
+// and level bootstrap, so the probe can drive the message loop itself.
+void ProbeStartGameLevel(interface_mode uMsg)
+{
+	if (!NetInit(true)) {
+		app_fatal("NetInit failed");
+	}
+	UiDestroy();
+	gbSelectProvider = false;
+	if (!gbValidSaveFile || !gbLoadGame) {
+		InitLevels();
+		InitQuests();
+		InitPortals();
+		InitDungMsgs(*MyPlayer);
+		DeltaSyncJunk();
+	}
+	giNumberOfLevels = gbIsHellfire ? 25 : 17;
+	ShowProgress(uMsg);
+	gmenu_init_menu();
+	InitLevelCursor();
+	sgnTimeoutCurs = CURSOR_NONE;
+	sgbMouseDown = CLICK_NONE;
+	LastPlayerAction = PlayerActionType::None;
+}
+
+void ProbePrepareForFadeIn()
+{
+	PrepareForFadeIn();
+}
+
+// devilGo-vsx3: exported accessor for the game event handler so external
+// drivers can mirror RunGameLoop without touching its internals.
+EventHandler ProbeGameEventHandler()
+{
+	return GameEventHandler;
+}
