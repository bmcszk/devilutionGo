#!/usr/bin/env bash
# Pre-commit gate: staged Go files must be gofmt-clean and lint-clean.
# The Pi-Session trailer gate lives in the commit-msg hook, which is the only
# hook that receives the message git is about to commit.
# Install with `just install-hooks`.
set -uo pipefail

staged_go=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)
[ -z "$staged_go" ] && exit 0

echo "pre-commit: gofmt on staged files"
printf '%s\n' "$staged_go" | xargs gofmt -l 2>/dev/null | grep -q . && {
	echo "BLOCKED: gofmt needed on:" >&2
	printf '%s\n' "$staged_go" | xargs gofmt -l >&2
	exit 1
}

pkgs=$(printf '%s\n' "$staged_go" | xargs -n1 dirname | sort -u | sed 's|^|./|; s|$|/...|')
lint_bin=golangci-lint
if [ -f .custom-gcl.yml ]; then
	lint_bin=./custom-gcl
	[ -x "$lint_bin" ] || golangci-lint custom >/dev/null
fi
echo "pre-commit: $lint_bin $pkgs"
# shellcheck disable=SC2086
if ! "$lint_bin" run $pkgs; then
	echo "BLOCKED: lint issues above must be fixed before commit" >&2
	exit 1
fi
